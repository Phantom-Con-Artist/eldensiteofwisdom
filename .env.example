# Cloudinary Configuration (used by both `cld` CLI and the Astro/Node `cloudinary` SDK)
# Find this in your Cloudinary Dashboard -> Programmable Media -> API Keys
# Format: cloudinary://<API_KEY>:<API_SECRET>@<CLOUD_NAME>
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name
PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name

# Elden Ring Free Public APIs (No API Key / Sign-up Required)
PUBLIC_ELDEN_RING_API_BASE=https://eldenring.fanapis.com/api
